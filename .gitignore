# ─── Python ───────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# ─── Edge device config (per-installation, secrets) ──────────
visionmetrics/edge/config/device.yaml

# ─── Cloud backend (local DB + secrets) ──────────────────────
cloud/.env
*.db
*.sqlite
*.sqlite3

# ─── Test footage (large, local-only; keep the folder README) ─
fixtures/*
!fixtures/README.md

# ─── Model weights (auto-downloaded on first run) ────────────
yolov8n.pt
models/face_landmarker.task
models/pose_landmarker_lite.task

# ─── Runtime data (generated by main.py) ─────────────────────
data/live_stats.json
data/hourly_log.json
data/session_history.json
data/session_log.csv

# ─── Per-store calibration (generated by calibrate.py) ───────
configs/store_config.json
configs/demo_zone.json          # generated by the demo menu (draw zone)

# ─── Demo session reports (generated by the demo menu; sent by hand) ──
results/

# ─── Recorded session videos (large, local-only) ─────────────
recordings/

# ─── Labelled crop images (keep the CSVs — they're the training data — but the
#     per-session crop folders are only needed for re-labelling; skip them so the
#     shared repo stays light) ──────────────────────────────────────────────
data/raw_sessions/*_images/
data/raw_sessions/*_detimages/

# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ─── OS files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude internal ─────────────────────────────────────────
.claude/

# ─── Docs folder (internal — not for submission) ─────────────
docs/

# ─── Internal working files ───────────────────────────────────
CONTEXT.md
DEMO_UPGRADES_PLAN.md
project_guidelines.md

# ─── Remotion demo (internal) ────────────────────────────────
remotion-demo/
